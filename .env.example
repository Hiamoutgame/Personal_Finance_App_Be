API_HOST_PORT=5284
API_CONTAINER_PORT=8080
POSTGRES_HOST_PORT=5432
POSTGRES_DB=PersonalFinanceManagementDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password

ASPNETCORE_ENVIRONMENT=Production
APPLY_MIGRATIONS=true
ENABLE_SWAGGER=true
ALLOWED_HOSTS=*

JwtOptions__SecretKey=replace-with-a-long-random-secret-at-least-32-chars
JwtOptions__Issuer=PersonalFinanceManagement
JwtOptions__Audience=PersonalFinanceManagement
JwtOptions__ExpireMinutes=120

SeedAccounts__Enabled=true
SeedAccounts__ResetPasswords=true
SeedAccounts__Accounts__0__Username=user
SeedAccounts__Accounts__0__Email=user@example.com
SeedAccounts__Accounts__0__Password=User@123456
SeedAccounts__Accounts__0__FirstName=Test
SeedAccounts__Accounts__0__LastName=User
SeedAccounts__Accounts__0__Role=User
SeedAccounts__Accounts__1__Username=admin
SeedAccounts__Accounts__1__Email=admin@example.com
SeedAccounts__Accounts__1__Password=Admin@123456
SeedAccounts__Accounts__1__FirstName=Test
SeedAccounts__Accounts__1__LastName=Admin
SeedAccounts__Accounts__1__Role=Admin

CloudinaryOptions__CloudName=
CloudinaryOptions__ApiKey=
CloudinaryOptions__ApiSecret=

MailOptions__Mail=
MailOptions__DisplayName=FinJar
MailOptions__Password=
MailOptions__Host=smtp.gmail.com
MailOptions__Port=587

Ocr__BaseUrl=
Ocr__Layout=invoice
Ocr__TimeoutSeconds=120

GoogleAI__ApiKey=
GoogleAI__DefaultModel=gemini-2.5-flash
GoogleAI__IsEnabled=true
GoogleAI__Temperature=0.7
GoogleAI__MaxTokens=1000
GoogleAI__TimeoutSeconds=100
GoogleAI__SystemPrompt=You are FinJar, a personal finance assistant. Answer in Vietnamese. Be concise, practical, and avoid exposing secrets or raw internal data.

Casso__ConnectionMode=ApiKey
Casso__BaseUrl=https://oauth.casso.vn/v2
Casso__AuthorizationUrl=https://oauth.casso.vn/auth/authorize
Casso__TokenUrl=https://oauth.casso.vn/auth/token
Casso__ClientId=
Casso__ClientSecret=
Casso__RedirectUri=http://localhost:5284/api/v1/financial-accounts/casso/callback
Casso__DefaultReturnUrl=http://localhost:5173/accounts
Casso__AllowedReturnUrlPrefix=http://localhost:5173
Casso__Scope=webhook transaction
Casso__WebhookSecureToken=
Casso__TokenEncryptionKey=replace-with-a-long-random-secret-at-least-32-chars
Casso__TimeoutSeconds=30
Casso__ApiKey=

CasooOptions__BaseUrlTransactions=https://oauth.casso.vn/v2/transactions
CasooOptions__TimeoutSeconds=30
CasooOptions__ApiKey=
CasooOptions__SecureToken=
CasooOptions__WebhookSecureToken=
